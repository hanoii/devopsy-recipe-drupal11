#!/bin/sh
## Description: Remove the containers, volumes and data in mnt/ (run on the server by --destroy)
# The environments' destroy step (config.yaml), run on the server by
# `devopsy @<target> --destroy` before devopsy removes the directory. Locally
# it deletes the site: database and files.
#
# mnt/ holds files owned by the app (10001) and MariaDB (999), which the
# deploy user cannot remove: the database image deletes them as root.
set -eu
devopsy down --volumes --remove-orphans
devopsy run --rm --no-deps -T --user 0 --entrypoint find \
  -v "$DEVOPSY_PROJECT_DIR/mnt:/devopsy-mnt" database /devopsy-mnt -mindepth 1 -delete
